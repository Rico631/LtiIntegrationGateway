{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Gateway": "Data Source=gateway.db"
  },
  "Inbound": {
    "RateLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "Outbound": {
    "DeliveryDispatcher": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "BatchSize": 50
    }
  },
  "Management": {
    "ApiKey": "",
    "HeaderName": "X-Management-Api-Key"
  },
  "AllowedHosts": "*"
}
