<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 SDK: без этого dotnet test упирается в неподдерживаемый VSTest-таргет MTP -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- API тестовых фикстур задаётся удобством вызова, а не статикой. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="TUnit" Version="1.76.45" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LtiIntegrationGateway\LtiIntegrationGateway.csproj" />
  </ItemGroup>

</Project>
