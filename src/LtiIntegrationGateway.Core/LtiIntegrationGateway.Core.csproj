<Project Sdk="Microsoft.NET.Sdk">

  <!-- Модель данных и чистые проверки, общие для management и flow. Хостов, middleware и Rebus
       здесь нет. FrameworkReference нужен ради RoutePatternFactory и абстракций health checks. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CA1822: валидатор маршрутов намеренно остаётся экземплярным — его подставляют через DI. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LtiIntegrationGateway.Contracts\LtiIntegrationGateway.Contracts.csproj" />
  </ItemGroup>

</Project>
