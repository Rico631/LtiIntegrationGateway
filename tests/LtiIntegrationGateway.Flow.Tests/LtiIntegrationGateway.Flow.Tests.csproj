    <ProjectReference Include="..\..\src\LtiIntegrationGateway.Flow\LtiIntegrationGateway.Flow.csproj" />
    <ProjectReference Include="..\..\src\LtiIntegrationGateway.Core\LtiIntegrationGateway.Core.csproj" />
  </ItemGroup>

</Project>
